# Document RAG Assistant - Backend Environment Configuration

PORT=5000

# Google Gemini API Key (e.g. from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

# OpenAI API Key (optional, if using OpenAI)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Vector Database (ChromaDB)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=document_rag_collection
TOP_K=5
